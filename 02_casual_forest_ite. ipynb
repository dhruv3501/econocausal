      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "def calculate_smd(data, treated_idx, control_idx, columns):\n",
        "    results = []\n",
        "\n",
        "    for col in columns:\n",
        "        treated = data.iloc[treated_idx][col].astype(float)\n",
        "        control = data.iloc[control_idx][col].astype(float)\n",
        "\n",
        "        pooled_sd = np.sqrt(\n",
        "            (treated.var() + control.var()) / 2\n",
        "        )\n",
        "\n",
        "        smd = (\n",
        "            (treated.mean() - control.mean()) / pooled_sd\n",
        "            if pooled_sd > 0 else 0\n",
        "        )\n",
        "\n",
        "        results.append({\n",
        "            \"Feature\": col,\n",
        "            \"SMD\": smd,\n",
        "            \"Absolute SMD\": abs(smd)\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(results)\n",
        "\n",
        "features = [\n",
        "    \"age\", \"income\", \"tenure\", \"past_purchases\",\n",
        "    \"days_since_last_purchase\"\n",
        "]\n",
        "\n",
        "# Balance after matching\n",
        "matched_balance = calculate_smd(\n",
        "    data,\n",
        "    treated_idx,\n",
        "    matched_control_idx,\n",
        "    features\n",
        ")\n",
        "\n",
